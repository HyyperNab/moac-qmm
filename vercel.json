{
  "name": "moac-qmm-demo",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "demo/public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/demo/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/demo/public/$1"
    }
  ]
}
